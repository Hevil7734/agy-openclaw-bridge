# AGY-OpenClaw API Bridge Configuration Example
# Copy to .env and adjust if needed

# Server Network Settings (Port security: bind strictly to localhost)
AGY_API_HOST=127.0.0.1
AGY_API_PORT=8000

# Optional API authentication key (leave empty to allow unauthenticated localhost calls)
AGY_API_KEY=

# Execution Settings
AGY_DEFAULT_MODEL=gemini-3.8-flash-high
AGY_DEFAULT_EFFORT=high
AGY_TIMEOUT=180

# Multi-Worker Pool Settings
AGY_POOL_DISPATCH_MODE=least_busy

# Conversation Storage Policy (ephemeral, session, or persist)
AGY_CONVERSATION_MODE=ephemeral
AGY_CLEANUP_EPHEMERAL=true
